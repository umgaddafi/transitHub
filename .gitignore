# Root Git Ignore
node_modules/
.vite/
dist/

# Environment Files (Keep all secrets strictly local!)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.local_backup

# Database Dumps (Never commit DB backups with user data or token hashes)
*.sql
*.sql.gz
*.dump

# Backend
backend/vendor/
backend/storage/*.key
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/logs/*.log
backend/public/storage
backend/public/hot

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# IDE / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
