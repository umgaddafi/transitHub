<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Route /api/ requests to the Laravel Backend
    RewriteRule ^api/(.*)$ backend/public/index.php [L,QSA]

    # Handle assets, images, videos, favicons when requested from nested paths
    RewriteRule ^.+/(assets/.*)$ $1 [L]
    RewriteRule ^.+/(images/.*)$ $1 [L]
    RewriteRule ^.+/(videos/.*)$ $1 [L]
    RewriteRule ^.+/(favicon.*)$ $1 [L]
    RewriteRule ^.+/(icons.*)$ $1 [L]
    RewriteRule ^.+/(apple-touch-icon.*)$ $1 [L]

    # Route all other requests to React's index.html (for React Router / SPA)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [QSA,L]
</IfModule>
