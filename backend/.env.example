APP_NAME=TransitHub
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tickets.example.com
FRONTEND_URL=https://tickets.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Production uses MySQL with transactional tables. Use a dedicated account.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=transithub
DB_USERNAME=transithub
DB_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
BCRYPT_ROUNDS=12
API_TOKEN_TTL_MINUTES=720
BOOKING_HOLD_MINUTES=15
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Configure and test real email delivery before enabling password recovery.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=bookings@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Paystack Gateway Credentials
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=https://tickets.example.com/client

# Local/testing only. APP_ENV=local and at least 12 characters are required.
# DEMO_USER_PASSWORD=
